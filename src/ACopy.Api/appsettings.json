{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Paths": {
    "Database": "/data/acopy.db",
    "Backups": "/backups"
  },
  "Docker": {
    "Enabled": true,
    "Socket": "/var/run/docker.sock",
    "LabelPrefix": "acopy",
    "ScanSeconds": 60
  },
  "Auth": {
    "Disabled": false,
    "Password": ""
  },
  "Backup": {
    "MaxParallel": 2,
    "HistoryPerTarget": 200,
    "LogMaxChars": 16000
  },
  "Telegram": {
    "ApiUrl": ""
  }
}
